# 复制为 .env 并填入你的 DeepSeek API Key(https://platform.deepseek.com)
# 不填也可以运行:系统自动进入"离线演示模式",功能全部可用,只是回答来自本地知识库与模板
DEEPSEEK_API_KEY=

# 可选配置(一般不用改)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# RAG_TOP_K=3
# EMBEDDING_MODE=auto
# HOST=127.0.0.1
# PORT=8000

# ── 语音输入(Phase 2)────────────────────────────────────────
# 方案 A:Vercel AI Gateway(推荐)。模型 id 带命名空间,如 openai/whisper-1
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# 方案 B:直连 OpenAI。两个都填时 Gateway 优先
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 留空按上面的方案自动选:Gateway = openai/whisper-1,直连 = whisper-1
# TRANSCRIBE_MODEL=
# 可选 ISO-639-1:zh / en / yue...
# TRANSCRIBE_LANGUAGE=
# 给 whisper 的术语提示,提高分镜/场次/机位等词命中率
# TRANSCRIBE_PROMPT=以下是影视制作相关的内容,术语包括:分镜、场次、机位、景别、rundown、剧本、后期、调色、收音、打灯。
